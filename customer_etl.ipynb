import pandas as pd
# Import the CSV file
customer_data = pd.read_csv("Bakery_Customer_Data.csv")

customer_data.head() #returns the first five rows of a DataFrame

customer_data.shape #Get the number of rows and columns

customer_data.duplicated() #Shows the rows with duplicates as true and false

customer_data['phone'].fillna('Unknown', inplace=True) #Fill missing phone numbers and emails with 'Unknown' to prevent loss of data

customer_data['address'] = customer_data['delivery_address'].str.split(pat=',').str[0] # Extract the first part of the address before the first comma (street address)

customer_data['country_code'] = customer_data['delivery_address'].str.split(pat=',').str[1] # Extract the second part after the first comma (country code)

customer_data['zipcode'] = customer_data['delivery_address'].str.split(pat=',').str[2] # Extract the third part after the second comma (zipcode)

customer_data['last_delivery_date'] = customer_data['last_delivery'].str.split(pat=' ').str[0] # Extract the date part from the last_delivery column

customer_data['last_delivery_time'] = customer_data['last_delivery'].str.split(pat=' ').str[1] # Extract the time part from the last_delivery column

customer_data = customer_data.drop(['last_delivery'], axis = 1) # Drop the last_delivery column since we have already extracted the date and time parts

customer_data = customer_data.drop(['delivery_address'], axis = 1)

customer_data = customer_data.rename(columns = {'birthday': 'birth_day'}) # Rename the 'birthday' column to 'birth_date' for better clarity

customer_data.to_csv('customer_data_cleaned.csv', index=False) #Save the Cleaned DataFrame to a New CSV File

